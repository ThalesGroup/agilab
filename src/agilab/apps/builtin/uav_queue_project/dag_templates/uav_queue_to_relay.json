{
  "schema": "agilab.multi_app_dag.v1",
  "dag_id": "uav-queue-to-relay-template",
  "label": "UAV queue to relay",
  "description": "App-owned DAG that replays the exact delivered source-packet trace from the UAV queue worker as relay arrivals.",
  "execution": {
    "mode": "sequential_dependency_order",
    "runner_status": "controlled_real_stage_execution",
    "adapter": "uav_queue_to_relay_controlled",
    "stage_bindings": {
      "queue_baseline": "uav_queue_project.queue_baseline",
      "relay_followup": "uav_relay_queue_project.relay_followup"
    }
  },
  "nodes": [
    {
      "id": "queue_baseline",
      "app": "uav_queue_project",
      "execution": {
        "entrypoint": "uav_queue_project.queue_baseline",
        "params": {
          "files": "*.json",
          "nfile": 1,
          "routing_policy": "shortest_path",
          "sim_time_s": 30.0,
          "sampling_interval_s": 0.5,
          "source_rate_pps": 14.0,
          "queue_weight": 2.5,
          "random_seed": 2026,
          "emit_delivery_trace": true
        },
        "stages": [],
        "data_in": "uav_queue/scenarios",
        "data_out": "uav_queue/results",
        "reset_target": false
      },
      "purpose": "Run the base UAV queue scenario and export metrics with the exact delivered source-packet identities and timestamps.",
      "produces": [
        {
          "id": "queue_metrics",
          "kind": "summary_metrics",
          "path": "queue_analysis/uav_queue_summary_metrics.json"
        }
      ]
    },
    {
      "id": "relay_followup",
      "app": "uav_relay_queue_project",
      "execution": {
        "entrypoint": "uav_relay_queue_project.relay_followup",
        "params": {
          "files": "*.json",
          "nfile": 1,
          "routing_policy": "shortest_path",
          "sim_time_s": 30.0,
          "sampling_interval_s": 0.5,
          "source_rate_pps": 14.0,
          "queue_weight": 2.5,
          "random_seed": 2026,
          "use_upstream_delivery_trace": true
        },
        "stages": [],
        "data_in": "uav_relay_queue/scenarios",
        "data_out": "uav_relay_queue/results",
        "reset_target": false
      },
      "purpose": "Verify the original queue artifact inside the relay worker and replay every delivered source packet, including late deliveries, without resampling.",
      "consumes": [
        {
          "id": "queue_metrics",
          "kind": "summary_metrics",
          "path": "queue_analysis/uav_queue_summary_metrics.json"
        }
      ],
      "produces": [
        {
          "id": "relay_metrics",
          "kind": "summary_metrics",
          "path": "queue_analysis/uav_relay_queue_summary_metrics.json"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "queue_baseline",
      "to": "relay_followup",
      "artifact": "queue_metrics",
      "handoff": "Replay the original queue artifact's exact delivered source-packet trace as relay arrivals; verify its producer and SHA-256 inside the worker."
    }
  ]
}
